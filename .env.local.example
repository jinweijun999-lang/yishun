# AI provider config (placeholder only)
ZHIPU_API_KEY="replace-with-your-zhipu-api-key"

# Stripe Test Checkout placeholders. Copy to .env.local locally and fill with Stripe test mode values.
# Live checkout is blocked unless YISHUN_STRIPE_MODE=live AND STRIPE_LIVE_CUTOVER_ACK is set exactly.
YISHUN_STRIPE_MODE="test"
STRIPE_LIVE_CUTOVER_ACK=""
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_PRICE_REPORT_SINGLE="price_test_report_single"
STRIPE_PRICE_PREMIUM_MONTHLY="price_test_premium_monthly"
STRIPE_PRICE_PREMIUM_ANNUAL="price_test_premium_annual"
STRIPE_PRICE_CONSULTATION_SINGLE="price_test_consultation_single"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
STRIPE_WEBHOOK_SECRET="whsec_test_xxx"
