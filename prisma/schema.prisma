generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                     String   @id @default(cuid())
  email                  String   @unique
  passwordHash           String
  birthDate              String?
  birthTime              String?
  gender                 String?
  longitude              Float?
  latitude               Float?
  timezoneOffsetMinutes  Int?
  timezoneName           String?
  planTier               String   @default("free")
  consultationCredits    Int      @default(0)
  lastAdWatchedAt         DateTime?
  lastCreditsAccruedAt    DateTime?
  consultations          Consultation[]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Consultation {
  id         String   @id @default(cuid())
  userId     String
  question   String
  category   String?
  status     String
  response   String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
