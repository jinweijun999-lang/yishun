generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String   @id @default(cuid())
  email                  String   @unique
  passwordHash           String
  birthDate              String?
  birthTime              String?
  gender                 String?
  longitude              Float?
  latitude               Float?
  timezoneOffsetMinutes  Int?
  timezoneName           String?
  planTier               String   @default("free")
  consultationCredits    Int      @default(0)
  lastAdWatchedAt         DateTime?
  lastCreditsAccruedAt    DateTime?
  consultations          Consultation[]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Consultation {
  id         String   @id @default(cuid())
  userId     String
  question   String
  category   String?
  status     String
  response   Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StripeWebhookEvent {
  id                String   @id
  stripeEventType   String
  checkoutSessionId String?
  userId            String?
  product           String?
  status            String
  createdAt         DateTime @default(now())

  @@index([checkoutSessionId])
  @@index([userId])
}

model ShareLink {
  id                 String   @id
  anonymousId        String?
  sourceScreen       String
  cardType           String
  templateId         String
  locale             String   @default("en-US")
  publicPayload      Json
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  clickCount         Int      @default(0)
  generateClickCount Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  expiresAt          DateTime

  @@index([anonymousId])
  @@index([sourceScreen])
  @@index([cardType])
  @@index([expiresAt])
}

model SupportTicket {
  id             String   @id @default(cuid())
  publicId       String   @unique
  category       String
  status         String   @default("received")
  locale         String   @default("en")
  messagePreview String
  messageHash    String
  orderId        String?
  emailHash      String?
  emailDomain    String?
  sourceRoute    String?
  traceId        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@index([orderId])
}
