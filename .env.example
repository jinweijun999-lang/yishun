DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fortune_app"
AUTH_SECRET="replace-with-strong-random-string"
NEXT_PUBLIC_APP_URL="https://11263.com"
NEXT_PUBLIC_SITE_URL="https://11263.com"
NEXTAUTH_URL="https://11263.com"
YISHUN_RELEASE_SHA=""

# Google OAuth production contract. Configure the OAuth client in Google Cloud
# with exactly this redirect URI before enabling Google sign-in.
YISHUN_GOOGLE_OAUTH_REQUIRED="0"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="https://11263.com/api/auth/callback/google"

# Stripe Test Checkout (use Stripe test mode values only; never commit .env.local)
# Live checkout is blocked unless YISHUN_STRIPE_MODE=live AND STRIPE_LIVE_CUTOVER_ACK is set exactly.
YISHUN_STRIPE_MODE="test"
STRIPE_LIVE_CUTOVER_ACK=""
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_PRICE_REPORT_SINGLE="price_test_report_single"
STRIPE_PRICE_PREMIUM_MONTHLY="price_test_premium_monthly"
STRIPE_PRICE_PREMIUM_ANNUAL="price_test_premium_annual"
STRIPE_PRICE_CONSULTATION_SINGLE="price_test_consultation_single"

# Future Stripe webhook verification
STRIPE_WEBHOOK_SECRET="whsec_test_xxx"

# Analytics / monitoring sinks
NEXT_PUBLIC_YISHUN_ANALYTICS_ENDPOINT="/api/events"
YISHUN_ANALYTICS_FILE=""
YISHUN_ANALYTICS_FILES=""
YISHUN_ANALYTICS_DIR=""
YISHUN_STRIPE_WEBHOOK_EVENTS_FILE=""
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
